# ============================================================
# ClearUX SaaS — Environment Variables
# Copy this to .env.local and fill in your real keys
# ============================================================

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (dashboard.stripe.com → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Anthropic Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Resend Email (resend.com/api-keys)
RESEND_API_KEY=re_...

# Inngest (inngest.com — background job processing)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Jina Reader (optional — higher rate limits for crawling)
# JINA_API_KEY=jina_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
