# ============================================================
# ClearUX SaaS — Environment Variables
# Copy this to .env.local and fill in your real keys
# ============================================================

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (dashboard.stripe.com → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Anthropic Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (platform.openai.com — enables GPT-4o multi-model benchmarking)
# OPENAI_API_KEY=sk-...

# Google Gemini API (aistudio.google.com — enables Gemini multi-model benchmarking)
# Canonical name: GEMINI_API_KEY. The code also accepts GOOGLE_AI_API_KEY,
# GOOGLE_GENERATIVE_AI_API_KEY, and GOOGLE_API_KEY for compatibility.
# GEMINI_API_KEY=AIza...

# Resend Email (resend.com/api-keys)
RESEND_API_KEY=re_...

# Inngest (inngest.com — background job processing)
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Jina Reader (optional — higher rate limits for crawling)
# JINA_API_KEY=jina_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Screenshot system
# Option 1 (RECOMMENDED): ScreenshotOne — reliable, element highlighting, caching
# Sign up at screenshotone.com, free tier available
# SCREENSHOTONE_API_KEY=your-screenshotone-key

# Option 2: Google PageSpeed (free, page-level only — no element highlighting)
# GOOGLE_PAGESPEED_API_KEY=your-google-api-key

# Option 3: Self-hosted Puppeteer (fallback — needs chromium on serverless)
SCREENSHOT_INTERNAL_KEY=any-secret-string-here

# Required for self-hosted Puppeteer to call /api/screenshot
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# FTP / SFTP deployment — AES-256-GCM key for credential encryption
# Required to save FTP connections from /dashboard/connect. Any sufficiently
# long secret; rotated via re-saving connections.
FTP_ENCRYPTION_KEY=replace-with-32-plus-char-secret
