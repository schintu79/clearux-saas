{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/inngest/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/reports/*/pdf/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/reports/*/docx/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/screenshot/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
